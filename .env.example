# Copy this file to .env and fill in real values. .env is git-ignored.
#
# Vite bakes VITE_* vars into the build at build time (not read at runtime),
# so every deploy target (staging/prod) needs its own build with its own
# values — see .env.production.example for the prod-build variant.

# Leave unset in dev — vite.config.js proxies /catalog to inventory-service
# on localhost:8083. Required for any build served outside that dev proxy
# (staging/prod): point it at the real API Gateway URL.
# VITE_API_BASE_URL=

# Required for the landing page's hero image carousel.
# Get a free Access Key at https://unsplash.com/developers
# NOTE: this ships inside the client bundle and is readable by anyone via
# devtools — restrict it to your domain(s) in the Unsplash dashboard, don't
# treat it as a real secret.
VITE_UNSPLASH_ACCESS_KEY=
