# Copy this file to .env and fill in real values. .env is git-ignored.

# Optional: overrides the relative /catalog proxy target in production. Leave
# unset in dev — vite.config.js proxies /catalog to inventory-service.
# VITE_API_BASE_URL=

# Required for the landing page's hero image carousel.
# Get a free Access Key at https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=
