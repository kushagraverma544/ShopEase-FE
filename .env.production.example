# Template for the production build. Copy to .env.production (git-ignored)
# or pass these as --build-arg values to the Docker build (see Dockerfile) —
# don't rely on the plain .env file for prod, it's meant for local dev.

# Required in prod: the real API Gateway URL. The build fails fast if this
# is missing (see src/services/api/httpClient.js).
VITE_API_BASE_URL=https://api.example.com

VITE_UNSPLASH_ACCESS_KEY=
